<idea-plugin>
    <id>com.circleci.idea</id>
    <name>CircleCI</name>
    <vendor email="support@circleci.com" url="https://circleci.com">CircleCI</vendor>

    <description><![CDATA[
    <p>CircleCI integration for JetBrains IDEs</p>

    <p>Monitor, manage, and debug CircleCI runs directly within your IDE. This extension provides:</p>
    <ul>
      <li>Real-time run, workflow, and job status monitoring</li>
      <li>Run management (rerun, cancel, approve workflows)</li>
      <li>SSH debugging support for failed jobs</li>
      <li>CircleCI YAML configuration validation and IntelliSense</li>
      <li>Local configuration testing (unversioned config runs)</li>
      <li>Test results and artifact viewing</li>
    </ul>

    <p>Features include:</p>
    <ul>
      <li><strong>Run Monitoring:</strong> View runs, workflows, and jobs in a hierarchical tree view, filtered by branch, status, and age, or across all your projects</li>
      <li><strong>Workflow Actions:</strong> Rerun workflows from start or from failed jobs, cancel running workflows, approve on-hold jobs</li>
      <li><strong>SSH Debugging:</strong> Rerun failed jobs with SSH enabled and connect directly from the IDE</li>
      <li><strong>Config Validation:</strong> Validate CircleCI YAML configuration files before committing</li>
      <li><strong>Test Run:</strong> Test configuration changes locally without committing to version control</li>
    </ul>
    ]]></description>

    <!-- Product and plugin compatibility requirements -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends optional="true" config-file="git-support.xml">Git4Idea</depends>

    <dependencies>
        <!-- VcsRepositoryManager and Repository, for the current branch of a project's repository -->
        <module name="intellij.platform.vcs.dvcs"/>
        <module name="intellij.platform.vcs.dvcs.impl"/>
        <!-- The run list's filter drop-downs and avatars, as the Pull Requests list has -->
        <module name="intellij.platform.collaborationTools"/>
        <!-- The OAuth login flow the GitHub plugin logs in with -->
        <module name="intellij.platform.collaborationTools.auth"/>
        <module name="intellij.platform.collaborationTools.auth.base"/>
        <!-- ProgressStripe, the run list's loading bar -->
        <module name="intellij.platform.vcs.impl"/>
        <!-- FilterComponent, for the filters that always have a value -->
        <module name="intellij.platform.vcs.log.impl"/>
        <!-- Compose and Jewel, for the resource usage charts -->
        <module name="intellij.libraries.compose.foundation.desktop"/>
        <module name="intellij.libraries.compose.runtime.desktop"/>
        <module name="intellij.libraries.skiko"/>
        <module name="intellij.platform.compose"/>
        <module name="intellij.platform.jewel.foundation"/>
        <module name="intellij.platform.jewel.ui"/>
        <module name="intellij.platform.jewel.ideLafBridge"/>
    </dependencies>
    <depends optional="true" config-file="terminal-support.xml">org.jetbrains.plugins.terminal</depends>
    <depends optional="true" config-file="ssh-support.xml">intellij.ssh.plugin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window: top of the left stripe, with the other VCS tools (Commit, Pull Requests) -->
        <toolWindow id="CircleCI"
                    secondary="false"
                    icon="/icons/circleci.svg"
                    anchor="left"
                    factoryClass="com.circleci.idea.toolwindow.CircleCIToolWindowFactory"/>

        <!-- Settings/Configuration -->
        <applicationConfigurable
            parentId="tools"
            instance="com.circleci.idea.settings.CircleCIConfigurable"
            id="com.circleci.idea.settings.CircleCIConfigurable"
            displayName="CircleCI"/>

        <applicationService
            serviceImplementation="com.circleci.idea.settings.CircleCISettings"/>
        <applicationService
            serviceImplementation="com.circleci.idea.api.CircleCIApiService"/>

        <!-- Project Services -->
        <projectService
            serviceImplementation="com.circleci.idea.services.CircleCIProjectService"/>
        <projectService
            serviceImplementation="com.circleci.idea.project.CircleCIProjectService"/>
        <projectService
            serviceImplementation="com.circleci.idea.run.RunListService"/>
        <projectService
            serviceImplementation="com.circleci.idea.job.JobDetailsService"/>
        <projectService
            serviceImplementation="com.circleci.idea.state.CircleCIStateStore"/>
        <projectService
            serviceImplementation="com.circleci.idea.state.CircleCIStatePersistence"/>
        <projectService
            serviceImplementation="com.circleci.idea.auth.CircleCIAuthService"/>
        <projectService
            serviceImplementation="com.circleci.idea.toolwindow.CircleCIToolWindowService"/>

        <!-- Where the browser comes back to after logging in, on the IDE's built-in server -->
        <httpRequestHandler implementation="com.circleci.idea.auth.oauth.CircleCIOAuthCallbackHandler"/>

        <!-- Job pages, one editor tab per job -->
        <fileEditorProvider implementation="com.circleci.idea.job.JobEditorProvider"/>
        <fileIconProvider implementation="com.circleci.idea.job.JobFileIconProvider"/>

        <!-- Context pages, one editor tab per context -->
        <fileEditorProvider implementation="com.circleci.idea.context.ContextEditorProvider"/>
        <fileIconProvider implementation="com.circleci.idea.context.ContextFileIconProvider"/>

        <!-- Startup Activity -->
        <postStartupActivity implementation="com.circleci.idea.CircleCIStartupActivity"/>

        <!-- Status Bar Widget -->
        <statusBarWidgetFactory
            id="CircleCIStatusBar"
            implementation="com.circleci.idea.statusbar.CircleCIStatusBarWidgetFactory"
            order="after memoryUsageWidget"/>

        <!-- Notification Group -->
        <notificationGroup
            id="CircleCI Notifications"
            displayType="BALLOON"
            isLogByDefault="true"/>

        <!-- Language Server Protocol Support -->
        <platform.lsp.integrationProvider
            implementation="com.circleci.idea.lsp.CircleCILspIntegrationProvider"/>

        <!-- Application Service for LSP Manager -->
        <applicationService
            serviceImplementation="com.circleci.idea.lsp.CircleCILanguageServerManager"/>
    </extensions>

    <projectListeners>
        <listener class="com.circleci.idea.project.CircleCIRepositoryMappingListener"
                  topic="com.intellij.dvcs.repo.VcsRepositoryMappingListener"/>
        <listener class="com.circleci.idea.project.ProjectLinkFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <!-- Main Menu Actions -->
        <group id="CircleCI.MainMenu" text="CircleCI" description="CircleCI actions" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="CircleCI.Login"
                    class="com.circleci.idea.actions.LoginAction"
                    text="Login to CircleCI"
                    description="Authenticate with CircleCI"/>

            <action id="CircleCI.Logout"
                    class="com.circleci.idea.actions.LogoutAction"
                    text="Logout from CircleCI"
                    description="Sign out and clear credentials"/>

            <action id="CircleCI.RefreshRuns"
                    class="com.circleci.idea.actions.RefreshRunsAction"
                    text="Refresh Runs"
                    description="Refresh the run list"
                    icon="AllIcons.Actions.Refresh"/>

            <separator/>

            <action id="CircleCI.ValidateConfig"
                    class="com.circleci.idea.actions.ValidateConfigAction"
                    text="Validate CircleCI Config"
                    description="Validate .circleci/config.yml"/>

            <action id="CircleCI.TestRun"
                    class="com.circleci.idea.actions.TestRunAction"
                    text="Test Run Configuration"
                    description="Start a run with local configuration"/>

            <separator/>

            <action id="CircleCI.OpenSettings"
                    class="com.circleci.idea.actions.OpenSettingsAction"
                    text="Settings..."
                    description="Open CircleCI settings"/>
        </group>

        <!-- Editor Context Menu for CircleCI Config Files -->
        <group id="CircleCI.EditorPopupMenu">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <separator/>
            <reference ref="CircleCI.ValidateConfig"/>
            <reference ref="CircleCI.TestRun"/>
        </group>
    </actions>
</idea-plugin>

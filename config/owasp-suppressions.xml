<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
    This file contains suppression rules for OWASP Dependency-Check.

    Add suppressions for false positives or accepted vulnerabilities.

    Example:
    <suppress>
        <notes><![CDATA[
        False positive - this CVE doesn't apply to our usage
        ]]></notes>
        <cve>CVE-2021-12345</cve>
    </suppress>

    Suppress by GAV (Group, Artifact, Version):
    <suppress>
        <notes><![CDATA[
        Accepted risk - vulnerability doesn't affect our use case
        ]]></notes>
        <gav regex="true">^com\.example:.*:.*$</gav>
        <cve>CVE-2021-12345</cve>
    </suppress>
    -->

    <!-- IntelliJ Platform dependencies are managed by JetBrains -->
    <suppress>
        <notes><![CDATA[
        IntelliJ Platform bundled dependencies are managed and patched by JetBrains.
        These are not directly under our control.
        ]]></notes>
        <gav regex="true">^com\.jetbrains.*:.*:.*$</gav>
    </suppress>

</suppressions>
